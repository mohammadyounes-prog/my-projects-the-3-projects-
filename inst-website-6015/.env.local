# Website public URLs (inst-website-6015)
# Copy to .env.local and adjust ports to match your local stack.
# Without .env.local, the app falls back to these same defaults (see src/lib/publicEnv.ts).
#
# Local suite map:
#   Website (this app, next dev --port 6015)  → http://localhost:6015
#   Auth / SSO API                            → http://localhost:8001  (:8000 often taken)
#   Online exam / assessment admin            → http://localhost:8080  (external; optional)
#   Dashboard (serve build on 6019; CRA/dev often 6018) → http://localhost:6019
#   QuestAI / question retrieval              → http://localhost:6016
#
# Typical local servers to run for SSO smoke:
#   1) Auth API on :8001 (QI)
#   2) This website: npm run dev  (:6015)
#   3) Optional targets: online-exam :8080, dashboard :6019, QuestAI :6016

# Auth / SSO API base (login POST /token, /api/v1/auth/generate-sso-token, Google)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Online exam / assessment admin app (Features “Try Assessment” → /admin)
NEXT_PUBLIC_ONLINE_EXAM_URL=http://localhost:8080

# Dashboard CRA (Features “Try AI Tools” → /login; hub SSO → /?sso_token=…)
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:6019

# QuestAI / question retrieval (hub SSO → /home.html?sso_token=…)
NEXT_PUBLIC_QUESTION_RETRIEVAL_URL=http://localhost:6016
