27\u0644\u0623\u062d\u0645\u0631\",\"choice_3\":\"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u0628\u064a\u0636 \u0627\u0644\u0645\u062a\u0648\u0633\u0637\",\"choice_4\":\"\u0628\u062d\u0631 \u0627\u0644\u062c\u0644\u064a\u0644\",\"correct_option\":\"C\",\"difficulty_level\":\"Medium\",\"cognitive_level\":\"Remembering\",\"learning_outcome\":\"ability to identify places\",\"question_type\":null,\"school_type\":\"International\",\"subject\":\"History\",\"year\":\"Year 12\",\"major\":null,\"course\":null,\"material\":null,\"semester\":null,\"company\":null,\"department\":null,\"job_role\":null,\"audience_type\":\"school\",\"mark\":5,\"time_seconds\":120,\"discriminating_factor\":null,\"status\":\"pending\",\"variables\":null,\"solution\":\"\u064a\u062d\u062f \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u0628\u064a\u0636 \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0641\u0644\u0633\u0637\u064a\u0646 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0645\u0646 \u062c\u0647\u0629 \u0627\u0644\u063a\u0631\u0628\u060c \u0648\u0647\u0648 \u0634\u0631\u064a\u0627\u0646 \u062d\u064a\u0648\u064a \u0644\u0644\u062a\u062c\u0627\u0631\u0629 \u0648\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0646\u0630 \u0622\u0644\u0627\u0641 \u0627\u0644\u0633\u0646\u064a\u0646.\",\"answers_hidden\":false},{\"question_id\":1542,\"author_creator\":\"TDM-AI-Engin\",\"date_created\":\"2026-06-20\",\"question_text\":\"\u0645\u0627 \u0647\u0648 \u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0642\u062f\u064a\u0645 \u0644\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062a\u064a \u062a\u0634\u0645\u0644 \u0641\u0644\u0633\u0637\u064a\u0646\u060c \u0648\u063a\u0627\u0644\u0628\u0627\u064b \u0645\u0627 \u064a\u064f\u0634\u0627\u0631 \u0625\u0644\u064a\u0647\u0627 \u0641\u064a \u0627\u0644\u0633\u064a\u0627\u0642\u0627\u062a \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0642\u0628\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0631\u0648\u0645\u0627\u0646\u064a\u0629\u061f\",\"choice_1\":\"\u0628\u0644\u0627\u062f \u0627\u0644\u0631\u0627\u0641\u062f\u064a\u0646\",\"choice_2\":\"\u0627\u0644\u0634\u0627\u0645\",\"choice_3\":\"\u0645\u0635\u0631 \u0627\u0644\u0633\u0641\u0644\u0649\",\"choice_4\":\"\u0627\u0644\u0623\u0646\u0627\u0636\u0648\u0644\",\"correct_option\":\"B\",\"difficulty_level\":\"Medium\",\"cognitive_level\":\"Remembering\",\"learning_outcome\":\"ability to identify places\",\"question_type\":null,\"school_type\":\"International\",\"subject\":\"History\",\"year\":\"Year 12\",\"major\":null,\"course\":null,\"material\":null,\"semester\":null,\"company\":null,\"department\":null,\"job_role\":null,\"audience_type\":\"school\",\"mark\":5,\"time_seconds\":120,\"discriminating_factor\":null,\"status\":\"pending\",\"variables\":null,\"solution\":\"\u062a\u064f\u0639\u0631\u0641 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062a\u064a \u062a\u0634\u0645\u0644 \u0641\u0644\u0633\u0637\u064a\u0646 \u062a\u0627\u0631\u064a\u062e\u064a\u0627\u064b \u0628\u0627\u0633\u0645 \u0627\u0644\u0634\u0627\u0645\u060c \u0648\u0647\u064a \u0645\u0646\u0637\u0642\u0629 \u062c\u063a\u0631\u0627\u0641\u064a\u0629 \u0623\u0648\u0633\u0639 \u062a\u0636\u0645 \u0633\u0648\u0631\u064a\u0627 \u0648\u0644\u0628\u0646\u0627\u0646 \u0648\u0627\u0644\u0623\u0631\u062f\u0646 \u0648\u0641\u0644\u0633\u0637\u064a\u0646.\",\"answers_hidden\":false},{\"question_id\":1541,\"author_creator\":\"TDM-AI-Engin\",\"date_created\":\"2026-06-16\",\"question_text\":\"Which of the following statements correctly describes Kirchhoff's Current Law (KCL)?\",\"choice_1\":\"The sum of all voltages around any closed loop in a circuit is equal to zero.\",\"choice_2\":\"The algebraic sum of currents entering a junction (node) is equal to the algebraic sum of currents leaving that junction.\",\"choice_3\":\"The total resistance of a series circuit is the sum of individual resistances.\",\"choice_4\":\"The current flowing through a conductor between two points is directly proportional to the voltage across the two points.\",\"correct_option\":\"B\",\"difficulty_level\":\"Easy\",\"cognitive_level\":\"Remembering\",\"learning_outcome\":\"Communication Proficiency\",\"question_type\":\"multiple choice\",\"school_type\":\"Primary\",\"subject\":\"Science\",\"year\":\"Year 12\",\"major\":null,\"course\":null,\"material\":null,\"semester\":null,\"company\":null,\"department\":null,\"job_role\":null,\"audience_type\":\"school\",\"mark\":5,\"time_seconds\":120,\"discriminating_factor\":null,\"status\":\"pending\",\"variables\":null,\"solution\":\"Kirchhoff's Current Law (KCL) states that the algebraic sum of currents entering a junction (node) is equal to the algebraic sum of currents leaving that junction. This principle is based on the conservation of electric charge. Option A describes Kirchhoff's Voltage Law (KVL). Option C describes a property of series circuits, and Option D describes Ohm's Law.\",\"answers_hidden\":false}]}", "url": "http://localhost:6016/index.html", "timestamp": "2026-07-06T18:24:02.026Z"}
