\u0629: \\\\(F = m \\\\times a\\\\).\\n\u0628\u0627\u0644\u062a\u0639\u0648\u064a\u0636 \u0628\u0627\u0644\u0642\u064a\u0645 \u0627\u0644\u0645\u0639\u0637\u0627\u0629:\\n\u0627\u0644\u0643\u062a\u0644\u0629 \\\\(m = 5 \\\\text{ kg}\\\\)\\n\u0627\u0644\u062a\u0633\u0627\u0631\u0639 \\\\(a = 2 \\\\text{ m/s}^2\\\\)\\n\u0625\u0630\u0646\u060c \u0627\u0644\u0642\u0648\u0629 \\\\(F = 5 \\\\text{ kg} \\\\times 2 \\\\text{ m/s}^2 = 10 \\\\text{ N}\\\\).\\n\u0644\u0630\u0644\u0643\u060c \u0645\u0642\u062f\u0627\u0631 \u0627\u0644\u0642\u0648\u0629 \u0647\u0648 \\\\(10 \\\\text{ N}\\\\).\",\"answers_hidden\":false},{\"question_id\":1544,\"author_creator\":\"TDM-AI-Engin\",\"date_created\":\"2026-06-20\",\"question_text\":\"\u0623\u064a \u0646\u0647\u0631 \u0645\u0647\u0645 \u064a\u0634\u0643\u0644 \u062c\u0632\u0621\u0627\u064b \u0645\u0646 \u0627\u0644\u062d\u062f\u0648\u062f \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0644\u0641\u0644\u0633\u0637\u064a\u0646 \u0627\u0644\u0642\u062f\u064a\u0645\u0629\u061f\",\"choice_1\":\"\u0646\u0647\u0631 \u0627\u0644\u0646\u064a\u0644\",\"choice_2\":\"\u0646\u0647\u0631 \u062f\u062c\u0644\u0629\",\"choice_3\":\"\u0646\u0647\u0631 \u0627\u0644\u0641\u0631\u0627\u062a\",\"choice_4\":\"\u0646\u0647\u0631 \u0627\u0644\u0623\u0631\u062f\u0646\",\"correct_option\":\"D\",\"difficulty_level\":\"Medium\",\"cognitive_level\":\"Remembering\",\"learning_outcome\":\"ability to identify places\",\"question_type\":null,\"school_type\":\"International\",\"subject\":\"History\",\"year\":\"Year 12\",\"major\":null,\"course\":null,\"material\":null,\"semester\":null,\"company\":null,\"department\":null,\"job_role\":null,\"audience_type\":\"school\",\"mark\":5,\"time_seconds\":120,\"discriminating_factor\":null,\"status\":\"pending\",\"variables\":null,\"solution\":\"\u064a\u0634\u0643\u0644 \u0646\u0647\u0631 \u0627\u0644\u0623\u0631\u062f\u0646 \u0627\u0644\u062d\u062f\u0648\u062f \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0644\u0641\u0644\u0633\u06