itive_level\":\"Understanding\",\"learning_outcome\":\"Technical Competence\",\"question_type\":\"yes_no\",\"school_type\":\"Secondary\",\"subject\":\"Physics\",\"year\":\"Year 11\",\"major\":null,\"course\":null,\"material\":null,\"semester\":null,\"company\":null,\"department\":null,\"job_role\":null,\"audience_type\":\"school\",\"mark\":5,\"time_seconds\":120,\"discriminating_factor\":null,\"status\":\"pending\",\"variables\":null,\"solution\":\"Newton's First Law of Motion accurately describes that an object's state of motion (either at rest or moving at a constant velocity) will only change if an external net force acts upon it. This principle is fundamental to understanding inertia.\",\"answers_hidden\":false},{\"question_id\":1480,\"author_creator\":\"TDM-AI-Engin\",\"date_created\":\"2026-05-04\",\"question_text\":\"[Dummy] Q1: Based on: newton laws...\",\"choice_1\":\"Yes\",\"choice_2\":\"No\",\"choice_3\":null,\"choice_4\":null,\"correct_option\":\"A\",\"difficulty_level\":\"Easy\",\"cognitive_level\":\"Understanding\",\"learning_outcome\":\"Technical Competence\",\"question_type\":\"yes_no\",\"school_type\":\"Secondary\",\"subject\":\"Physics\",\"year\":\"Year 11\",\"major\":null,\"course\":null,\"material\":null,\"semester\":null,\"company\":null,\"department\":null,\"job_role\":null,\"audience_type\":\"school\",\"mark\":5,\"time_seconds\":120,\"discriminating_factor\":null,\"status\":\"pending\",\"variables\":null,\"solution\":\"This is a dummy step-by-step solution.\",\"answers_hidden\":false},{\"question_id\":1479,\"author_creator\":\"TDM-AI-Engin\",\"date_created\":\"2026-05-03\",\"question_text\":\"Which of the following conditions must be met for Total Internal Reflection (TIR) to occur?\",\"choice_1\":\"Light must travel from an optically less dense medium to an optically more dense medium.\",\"choice_2\":\"The angle of incidence must be less than the critical angle.\",\"choice_3\":\"Light must travel from an optically more dense medium to an optically less dense medium, and the angle of incidence must be greater than the critical angle.\",\"choice_4\":\"Light must travel from an optically more dense medium to an optically less dense medium, and the angle of incidence must be equal to the critical angle.\",\"correct_option\":\"C\",\"difficulty_level\":\"Medium\",\"cognitive_level\":\"Understanding\",\"learning_outcome\":\"Communication Proficiency\",\"question_type\":\"multiple choice\",\"school_type\":\"International\",\"subject\":\"Science\",\"year\":\"Year 12\",\"major\":null,\"course\":null,\"material\":null,\"semester\":null,\"company\":null,\"department\":null,\"job_role\":null,\"audience_type\":\"school\",\"mark\":5,\"time_seconds\":120,\"discriminating_factor\":null,\"status\":\"pending\",\"variables\":null,\"solution\":\"Total Internal Reflection (TIR) occurs when two specific conditions are met: 1. Light must be traveling from an optically denser medium to an optically less dense medium (e.g., from water to air). 2. The angle of incidence in the denser medium must be greater than the critical angle. If the angle of incidence is equal to the critical angle, the light ray travels along the interface (refracts at \\\\(90^\\\\circ\\\\)).\",\"answers_hidden\":false},{\"question_id\":1478,\"author_creator\":\"TDM-AI-Engin\",\"date_created\":\"2026-05-03\",\"question_text\":\"When a monochromatic ray of light passes from an optically less dense medium (e.g., air) into an optically more dense medium (e.g., water), how do its speed and direction of travel change?\",\"choice_1\":\"Its speed increases and it bends away from the normal.\",\"choice_2\":\"Its speed decreases and it bends towards the normal.\",\"choice_3\":\"Its speed remains constant and it bends towards the normal.\",\"choice_4\":\"Its speed decreases and it bends away from the normal.\",\"correct_option\":\"B\",\"difficulty_level\":\"Medium\",\"cognitive_level\":\"Understanding\",\"learning_outcome\":\"Communication Proficiency\",\"question_type\":\"multiple choice\",\"school_type\":\"International\",\"subject\":\"Science\",\"year\":\"Year 12\",\"major\":null,\"course\":null,\"material\":null,\"semester\":null,\"company\":null,\"department\":null,\"job_role\":null,\"audience_type\":\"school\",\"mark\":5,\"time_seconds\":120,\"discriminating_factor\":null,\"status\":\"pending\",\"variables\":null,\"solution\":\"When light enters a denser optical medium, its speed decreases. According to Snell's Law (\\\\(n_1 \\\\sin \\\\theta_1 = n_2 \\\\sin \\\\theta_2\\\\)), if \\\\(n_2 > n_1\\\\) (denser medium), then \\\\(\\\\sin \\\\theta_2 < \\\\sin \\\\theta_1\\\\), which means \\\\(\\\\theta_2 < \\\\theta_1\\\\). This implies the light ray bends towards the normal.\",\"answers_hidden\":false},{\"question_id\":1477,\"author_creator\":\"TDM-AI-Engin\",\"date_created\":\"2026-05-03\",\"question_text\":\"A light ray strikes a plane mirror such that its angle of incidence is \\\\(30^\\\\circ\\\\). What is the angle between the incident ray and the reflected ray?\",\"choice_1\":\"\\\\(30^\\\\circ\\\\)\",\"choice_2\":\"\\\\(60^\\\\circ\\\\)\",\"choice_3\":\"\\\\(90^\\\\circ\\\\)\",\"choice_4\":\"\\\\(120^\\\\circ\\\\)\",\"correct_option\":\"B\",\"difficulty_level\":\"Medium\",\"cognitive_level\":\"Understanding\",\"learning_outcome\":\"Communication Proficiency\",\"question_type\":\"multiple choice\",\"school_type\":\"International\",\"subject\":\"Science\",\"year\":\"Year 12\",\"major\":null,\"course\":null,\"material\":null,\"semester\":null,\"company\":null,\"department\":null,\"job_role\":null,\"audience_type\":\"school\",\"mark\":5,\"time_seconds\":120,\"discriminating_factor\":null,\"status\":\"pending\",\"variables\":null,\"solution\":\"According to the Law of Reflection, the angle of incidence is equal to the angle of reflection. If the angle of incidence is \\\\(30^\\\\circ\\\\), then the angle of reflection is also \\\\(30^\\\\circ\\\\). The angle between the incident ray and the reflected ray is the sum of the angle of incidence and the angle of reflection: \\\\(30^\\\\circ + 30^\\\\circ = 60^\\\\circ\\\\).\",\"answers_hidden\":false}]}", "url": "http://localhost:6016/index.html", "timestamp": "2026-06-15T20:28:15.067Z"}
