# QuestAI backend environment (inst-QI-6016)
# Copy to backend/.env and fill in values. Never commit real secrets.
# See LOCAL_STACK.md for full local run instructions.

# --- Required for auth ---
# JWT secret for signing tokens (required in prod; insecure default exists for local only)
SECRET_KEY=change_this_to_a_strong_random_secret

# --- Server listen / public API URL ---
# run_server.py prefers PORT; otherwise extracts port from BACKEND_BASE_URL; default 8000.
# Website NEXT_PUBLIC_API_URL / QuestAI frontend expect the API on :8000 locally.
PORT=8000
BACKEND_BASE_URL=http://127.0.0.1:8000
# Legacy alias used by backend/config.py (not used by run_server.py)
# BACKEND_PORT=8000

# --- SQLite database ---
# FastAPI (backend/database.py) always uses inst-QI-6016/questions.db (path relative to backend/).
# DB_PATH is honored by utility/seed scripts (e.g. scripts/seed_local_demo.py). Leave unset for default.
# DB_PATH=

# --- Payments (local demos) ---
# Default is dummy gateway (no Stripe). Set false + STRIPE_API_KEY for real charges.
USE_DUMMY_PAYMENT_GATEWAY=true
# STRIPE_API_KEY=

# --- LLM / search keys (optional for dummy-model demos) ---
# Interactive generate works without these when the UI selects model_api_name "dummy"
# (backend short-circuits and returns fake questions). Real Gemini/OpenAI models need keys.
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
CSE_API_KEY=
GOOGLE_CSE_ID=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Admin bootstrap endpoint (local only; keep false in prod) ---
# POST /admin/bootstrap_user when true
BOOTSTRAP_ENABLED=false

# --- Online exam / SSO integration (optional for generate-only demos) ---
# ONLINE_EXAM_API_BASE_URL=http://localhost:8888/api
# ONLINE_EXAM_FRONTEND_BASE_URL=http://localhost:8888
# ONLINE_EXAM_JWT_SECRET=
# ONLINE_EXAM_MYSQL_HOST=localhost
# ONLINE_EXAM_MYSQL_PORT=3307
# ONLINE_EXAM_MYSQL_DB=schooldemo12
# ONLINE_EXAM_MYSQL_USER=root
# ONLINE_EXAM_MYSQL_PASSWORD=
