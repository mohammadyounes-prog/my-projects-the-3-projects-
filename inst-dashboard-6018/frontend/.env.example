# Dashboard frontend (CRA) — copy to .env and adjust ports to match your local stack.

# Backend API base — must include /api/v1 (routers mount under that prefix).
# Used by Login (`/auth/login`), SSO (`/auth/verify-sso`), and data endpoints (`/data/...`).
REACT_APP_API_BASE_URL=http://localhost:6018/api/v1
# Alias for API_BASE_URL (SsoHandler falls back to this if BASE_URL unset)
REACT_APP_API_URL=http://localhost:6018/api/v1

# Website / suite hub (used by "Back to Hub" in Layout logout modal)
REACT_APP_HUB_URL=http://localhost:6015

# SSO contract (website hub → dashboard):
#   Hub redirects to dashboard /?sso_token=<uuid>
#   SsoHandler calls GET {REACT_APP_API_BASE_URL}/auth/verify-sso?sso_token=<uuid>
#   Expects JSON: { "access_token": "<jwt>", "token_type": "bearer", "username"?, "name"?, "role"? }
#   Stores access_token in localStorage.token (+ role, user_name) and navigates to /home
#
# Role-based nav (localStorage.role — see src/auth/roles.ts):
#   admin / superadmin / missing → all modules (+ Weights)
#   instructor (TAMS employees) → Educational + Settings
#   executive* → Executive + Settings
#   corporate / hr → Corporate + Settings
#   Forbidden module URLs soft-redirect to /home
